modules = ["python-3.11", "postgresql-16"]
# Конфигурация для Replit

# Команда для запуска проекта
run = "python app.py"

# Язык проекта
language = "python3"

# Настройки сборки
[nix]
channel = "stable-22_11"

# Настройки окружения
[env]
PYTHONUTF8 = "1"
FLASK_APP = "app.py"

# Настройки инструментов
[tools]
# Настройки формата Python
[tools.autopep8]
[tools.black]
[tools.flake8]

# Настройки пакетов
[packager]
# Настройки языкового сервера
[languages]

[languages.python3]
pattern = "**/*.py"

[languages.python3.languageServer]
start = ["pylsp"]

# Настройки UPM (Universal Package Manager)
[unitTest]
[nix]
channel = "stable-25_05"
packages = ["openssl", "postgresql"]

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "main:app"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "gunicorn --bind 0.0.0.0:5000 --reuse-port --reload main:app"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[agent]
integrations = ["web_scraper==1.0.0"]
